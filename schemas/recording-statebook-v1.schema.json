{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-atlas.org/schemas/recording-statebook-v1.schema.json",
  "title": "UiAtlas rebuildable statebook v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["derivationVersion", "representativeFrames", "episodes"],
  "properties": {
    "derivationVersion": { "const": "statebook/1" },
    "representativeFrames": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "episodes": {
      "type": "array", "maxItems": 249,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["episodeId", "startFrameSequence", "endFrameSequence", "trigger", "outcome"],
        "properties": {
          "episodeId": { "type": "string", "minLength": 1, "maxLength": 128 }, "inputSequence": { "type": ["integer", "null"], "minimum": 1 },
          "startFrameSequence": { "type": "integer", "minimum": 1 }, "endFrameSequence": { "type": "integer", "minimum": 1 },
          "trigger": { "type": "string", "maxLength": 4096 }, "outcome": { "type": "string", "maxLength": 128 },
          "armedUtc": { "type": ["string", "null"], "format": "date-time" },
          "actionObservedUtc": { "type": ["string", "null"], "format": "date-time" },
          "streamsSettledUtc": { "type": ["string", "null"], "format": "date-time" },
          "expectedClickCount": { "type": "integer", "minimum": 1, "maximum": 2 },
          "observationStatus": { "type": "string", "maxLength": 128 }
        }
      }
    }
  }
}
