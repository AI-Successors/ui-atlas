<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="../UiAtlas.Core.Contracts/UiAtlas.Core.Contracts.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Reader/UiAtlas.Core.Reader.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Recording.Windows/UiAtlas.Core.Recording.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="GetDesktopExplorerDeploymentFiles" DependsOnTargets="GetTargetPath"
          Returns="@(_DesktopExplorerDeploymentFiles)">
    <ItemGroup>
      <!-- Shared OutDir builds may already contain a staged viewer. Never nest it. -->
      <_DesktopExplorerDeploymentFiles Include="$(TargetDir)**\*" Exclude="$(TargetDir)viewer\**\*" />
      <_DesktopExplorerDeploymentFiles Update="@(_DesktopExplorerDeploymentFiles)">
        <ExplorerRelativePath>%(RecursiveDir)%(Filename)%(Extension)</ExplorerRelativePath>
      </_DesktopExplorerDeploymentFiles>
    </ItemGroup>
  </Target>
</Project>
